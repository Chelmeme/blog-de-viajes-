        "Segoe UI Emoji",
        "Segoe UI Symbol",
        "Noto Color Emoji" !important;
      font-size: 12px !important;
      font-style: normal !important;
      font-weight: 500 !important;
      line-height: 170% !important;
      color: #404147 !important;
    }
    #didomi-host .didomi-exterior-border,
    #didomi-host .didomi-notice__interior-border,
    #didomi-host .didomi-consent-popup__dialog {
      border: none !important;
      border-radius: 0 !important;
    }
    #didomi-host .didomi-popup-container {
      overflow: hidden;
      background: #fff !important;
      border-radius: 18px !important;
      box-shadow: 0 4px 12.8px 0 rgba(0, 0, 0, 0.09), 0 8px 25.6px 0 rgba(0, 0, 0, 0.05), 0 16px 51.2px 0 rgba(0, 0, 0, 0.02);
    }
    #didomi-host .didomi-notice-banner {
      box-sizing: border-box !important;
      padding: 24px !important;
      position: fixed;
      left: 0 !important;
      right: 0 !important;
      bottom: 0;
      border: none !important;
      background: #fff !important;
      box-shadow: 0 4px 12.8px 0 rgba(0, 0, 0, 0.09), 0 8px 25.6px 0 rgba(0, 0, 0, 0.05), 0 16px 51.2px 0 rgba(0, 0, 0, 0.02);
      color: #404147 !important;
    }
    @media (min-width: 560px) {
      #didomi-host .didomi-notice-banner {
        width: calc(100% - 64px) !important;
        max-width: 496px !important;
        left: auto !important;
        bottom: 29px !important;
        margin: 0 32px !important;
        border-radius: 18px !important;
      }
    }
    #didomi-host .didomi-notice__interior-border {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 24px !important;
    }
    #didomi-host .push-right {
      margin: 0 !important;
    }
    #didomi-host .didomi-notice-banner .didomi-notice-text p > * {
      margin: 0 !important;
    }
    #didomi-host .didomi-notice-banner .didomi-notice-text p > *:empty {
      display: none !important;
    }
    #didomi-host .didomi-notice-banner .didomi-notice-text h2 {
      margin-bottom: 12px !important;
      color: #000 !important;
      font-size: 20px !important;
      font-style: normal !important;
      font-weight: 600 !important;
      line-height: normal !important;
    }
    #didomi-host .didomi-notice-banner .didomi-buttons {
      flex-direction: column !important;
      gap: 12px !important;
    }
    @media (min-width: 480px) {
      #didomi-host .didomi-notice-banner .didomi-buttons {
        flex-direction: row !important;
      }
    }
    #didomi-host .didomi-notice-banner .didomi-buttons .didomi-button {
      display: flex;
      height: 40px;
      padding: 0 12px;
      margin: 0 !important;
      justify-content: center;
      align-items: center;
      align-self: stretch;
      border-radius: 10px !important;
      border: none !important;
      box-shadow: none !important;
      text-align: center;
      font-size: 14px !important;
      font-style: normal !important;
      font-weight: 500 !important;
      outline: none !important;
      box-shadow: none !important;
    }
    #didomi-host .didomi-notice-banner .didomi-button-highlight {
      background: #000 !important;
      color: #fff !important;
    }
    #didomi-host .didomi-notice-banner .didomi-button-standard,
    #didomi-host .didomi-notice-banner .didomi-button-highlight.didomi-disagree-button {
      background: rgba(88, 38, 222, 0.06) !important;
      color: #000 !important;
    }
    #didomi-host .didomi-notice-banner a:not(.didomi-no-link-style) {
      color: #404147 !important;
      text-decoration: underline !important;
    }
