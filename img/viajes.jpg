    #didomi-host {
      font-family: Monserat, sans-serif;
    }
    #didomi-host a:not(.didomi-no-link-style) {
      text-decoration: underline;
      color: #4115d9 !important;
    }
    #didomi-host a:not(.didomi-no-link-style):hover {
      opacity: 0.7 !important;
    }
    
    #didomi-host {
      font-family:
        "TT Photoroom",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        "Helvetica Neue",
        Arial,
        "Noto Sans",
        sans-serif,
